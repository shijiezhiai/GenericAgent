{
  "productName": "GenericAgent",
  "version": "0.1.0",
  "identifier": "com.genericagent.desktop",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 28 },
        "userAgent": "GenericAgentDesktop/2.0 (Tauri; macOS)",
        "url": "loading.html"
      },
      {
        "title": "GenericAgent — Setup",
        "label": "setup",
        "width": 600,
        "height": 580,
        "resizable": false,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "url": "fallback.html"
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": ["runtime"],
    "targets": ["dmg"],
    "icon": ["icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null
    }
  }
}
